# ==== ApRID 环境变量 ====

# 初始管理员账号（首次启动写入数据库，之后可在面板内修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_please

# JWT 签名密钥（务必修改为随机长字符串）
JWT_SECRET=please_change_this_to_a_long_random_secret

# 服务端口（容器内），对外映射见 docker-compose.yml
PORT=6601

# 面板对外访问地址（用于生成订阅链接、二维码，以及告警通知里的免登录魔法链接）。
# 告警多由后台定时触发（无请求上下文），此时必须能拿到绝对地址：优先用此项，
# 也可在「设置 · 告警通知」里单独填「面板对外地址」。留空则用请求 Host 自动推断。
PUBLIC_BASE_URL=

# 数据库文件路径（容器内），docker-compose 已挂载持久化
DB_PATH=/data/aprid.db

# 信任设备有效期（天）
TRUSTED_DEVICE_DAYS=60

# 登录会话有效期（小时）
SESSION_HOURS=24
